FROM voidlinux/voidlinux:latest
# Use the main Void repo directly (bypass alpha mirror SSL issues on CI)
RUN xbps-install -S --repository=https://repo-default.voidlinux.org/current --repository=https://repo-default.voidlinux.org/current/nonfree \
    && xbps-install -y base-devel curl git cmake nodejs python3 cargo bash \
    && rm -rf /var/cache/xbps/*
CMD ["/bin/bash"]
